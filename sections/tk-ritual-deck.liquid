{%- style -%}
.rd-wide{font-stretch:125%;font-weight:900;text-transform:uppercase;letter-spacing:-0.01em}
.rd-serif{font-family:var(--tk-f-serif);font-weight:400;font-style:italic;text-transform:none;font-stretch:100%;letter-spacing:0}
.rd-lead{display:flex;align-items:center;gap:12px;font-size:24px;line-height:1}
.rd-lead::before{content:'';width:28px;height:2px;background:#E9A93C;flex:none}
.rd-big{display:block;font-size:66px;line-height:.86}
.rd-outline{color:transparent;-webkit-text-stroke:2px #E9A93C}
.rd-before{display:block;font-size:34px;line-height:1.05;margin-top:10px}
.rd-deck{position:relative;height:540px;margin:0 6px 40px;touch-action:pan-y;user-select:none;-webkit-user-select:none}
.rd-card{position:absolute;inset:0;border-radius:24px;overflow:hidden;display:flex;flex-direction:column;background:#0E0B09;color:#F4EADA;box-shadow:0 18px 40px rgba(0,0,0,.5);border:1.5px solid rgba(244,234,218,.12);transition:transform .45s cubic-bezier(.3,.1,.2,1),opacity .4s,background-color .45s}
.rd-p0{z-index:3}
.rd-p1{z-index:2;background:#E9A93C;border-color:#E9A93C;transform:translate(14px,18px) scale(.95) rotate(4deg)}
.rd-p2{z-index:1;background:#D8C3A0;border-color:#D8C3A0;transform:translate(-12px,32px) scale(.91) rotate(-5deg)}
.rd-p3{z-index:0;opacity:0;transform:translateY(32px) scale(.9)}
.rd-cream{background:#F4EADA;color:#171310}
.rd-p1 .rd-inner,.rd-p2 .rd-inner,.rd-p3 .rd-inner{opacity:0}
.rd-fly{z-index:4;transform:translateX(-130%) rotate(-14deg)!important;opacity:0}
.rd-fly-r{z-index:4;transform:translateX(130%) rotate(14deg)!important;opacity:0}
.rd-drag{transition:none!important;cursor:grabbing}
.rd-deck{cursor:grab}
.rd-hint{position:absolute;inset:0;z-index:6;border-radius:24px;background:rgba(14,11,9,.55);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;color:#F4EADA;pointer-events:none;opacity:0;transition:opacity .35s ease}
.rd-hint-on{opacity:1}
.rd-hint-t{padding:0 20px;text-align:center;font:900 18px var(--tk-f-sans);font-stretch:125%;letter-spacing:.04em;text-transform:uppercase}
.rd-hint-s{font:600 12px var(--tk-f-mono);letter-spacing:.1em;opacity:.8}
.rd-hand{display:flex;align-items:center;gap:6px;color:#E9A93C;animation:rdSwipe 1s ease-in-out infinite}
@keyframes rdSwipe{0%{transform:translateX(-24px);opacity:.3}60%{transform:translateX(24px);opacity:1}100%{transform:translateX(24px);opacity:0}}
.rd-inner{position:absolute;inset:0;display:flex;flex-direction:column;transition:opacity .4s}
.rd-photo{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.rd-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(14,11,9,0) 25%,rgba(14,11,9,.55) 52%,rgba(14,11,9,.96) 100%)}
.rd-num{position:absolute;left:16px;top:14px;z-index:2;font:600 12px var(--tk-f-mono);letter-spacing:.12em;color:#F4EADA;background:rgba(14,11,9,.6);padding:5px 9px;border-radius:999px}
.rd-cbody{position:relative;z-index:2;margin-top:auto;padding:22px;display:flex;flex-direction:column;gap:12px}
.rd-ctitle{margin:0;font-size:72px;line-height:.85}
.rd-cline{margin:0;font-size:17px;font-weight:700;line-height:1.35}
.rd-stat{display:flex;flex-direction:column;gap:6px;border-top:1.5px solid rgba(244,234,218,.3);padding-top:14px}
.rd-stat-n{font-size:28px;line-height:1;color:#E9A93C}
.rd-stat-t{font-size:20px;line-height:1.15}
.rd-breath{position:relative;flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;padding-top:24px}
.rd-circwrap{position:relative;width:180px;height:180px;display:grid;place-items:center}
.rd-circ{position:absolute;inset:0;border-radius:50%;background:radial-gradient(circle at 40% 35%,#F2BC5A,#E9A93C 45%,#C9861A);transform:scale(.45);transition:transform 4s ease-in-out;box-shadow:0 0 60px rgba(233,169,60,.35)}
.rd-circ-in{transform:scale(1)}
.rd-circ-idle{animation:rdIdle 3s ease-in-out infinite}
@keyframes rdIdle{0%,100%{transform:scale(.45)}50%{transform:scale(.5)}}
.rd-core{position:relative;z-index:1;width:84px;height:84px;border-radius:50%;border:0;background:transparent;cursor:pointer;display:grid;place-items:center;color:#0E0B09;font:900 38px var(--tk-f-sans);font-stretch:125%;line-height:1;padding:0}
.rd-core-sm{font-size:13px;letter-spacing:.06em}
.rd-phase{font:900 14px var(--tk-f-sans);font-stretch:125%;letter-spacing:.12em;text-transform:uppercase;color:#E9A93C;min-height:18px;margin:0;text-align:center}
.rd-phase span{color:#F4EADA;opacity:.75;font-family:var(--tk-f-mono);font-weight:600;font-stretch:100%;letter-spacing:.04em}
.rd-nav{width:48px;height:48px;border-radius:50%;border:1.5px solid rgba(244,234,218,.4);background:transparent;color:#F4EADA;cursor:pointer;display:flex;align-items:center;justify-content:center}
.rd-pg{width:8px;height:8px;border-radius:50%;background:rgba(244,234,218,.3);transition:all .25s}
.rd-pg-on{background:#E9A93C;width:24px;border-radius:4px}
.rd-steps{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.rd-sum{justify-content:center;gap:22px;padding:28px 24px}
.rd-step{font:900 12px var(--tk-f-sans);font-stretch:125%;letter-spacing:.06em;text-transform:uppercase;border:1.5px solid #171310;border-radius:999px;padding:6px 10px}
.rd-arrow{font:600 12px var(--tk-f-mono);opacity:.5}
{%- endstyle -%}
<section id="ritual" aria-labelledby="rd-h-{{ section.id }}" style="background: #171310; color: #F4EADA; padding: 64px 20px 72px">
  <tk-deck style="max-width: 480px; margin: 0 auto; display: flex; flex-direction: column; gap: 26px">
    <div style="display: flex; flex-direction: column; gap: 18px">
      <h2 id="rd-h-{{ section.id }}" style="margin: 0">
        <span class="rd-lead rd-serif">All you need is</span>
        <span class="rd-big rd-wide" style="margin-top: 14px">Thirty</span>
        <span class="rd-big rd-wide rd-outline">Seconds</span>
        <span class="rd-before rd-serif">before your <span style="color: #E9A93C">heavy moment.</span></span>
      </h2>
      <p style="margin: 0; font-size: 16px; line-height: 1.5; color: rgba(244,234,218,.75); max-width: 320px">{{ section.settings.intro }}</p>
    </div>

    <div class="rd-deck" data-deck role="group" aria-roledescription="carousel" aria-label="The ritual in four cards">
      <div class="rd-card rd-p0" role="group" aria-roledescription="slide" aria-label="1 of 4: Splash">
        <div class="rd-inner">
          <img class="rd-photo" src="{%- render 'tk-src', f: section.settings.img_splash, w: 900 -%}" alt="A hand splashing TEKILA Anxiety on the wrist" loading="lazy" width="900" height="1125">
          <div class="rd-shade"></div>
          <span class="rd-num">01 / 04</span>
          <div class="rd-cbody">
            <h3 class="rd-wide rd-ctitle">Splash.</h3>
            <p class="rd-cline" data-kicker>Before the room.</p>
            <div class="rd-stat"><span class="rd-wide rd-stat-n">3 splashes</span><span class="rd-serif rd-stat-t">Wrists, then neck. You've made the first move before the moment even starts.</span></div>
          </div>
        </div>
      </div>
      <div class="rd-card rd-p1" role="group" aria-roledescription="slide" aria-label="2 of 4: Breathe" aria-hidden="true">
        <div class="rd-inner">
          <span class="rd-num">02 / 04</span>
          <div class="rd-breath">
            <div class="rd-circwrap">
              <div class="rd-circ rd-circ-idle" data-circ></div>
              <button type="button" class="rd-core rd-core-sm" data-core aria-label="Start three breaths" tabindex="-1">START</button>
            </div>
            <p class="rd-phase" aria-live="polite" data-phase>Tap the circle <span></span></p>
          </div>
          <div class="rd-cbody" style="margin-top: 0">
            <h3 class="rd-wide rd-ctitle">Breathe.</h3>
            <p class="rd-cline">In for four. Out for four.</p>
            <div class="rd-stat"><span class="rd-wide rd-stat-n">3 breaths</span><span class="rd-serif rd-stat-t">The scent settles as you do. Only you can smell it.</span></div>
          </div>
        </div>
      </div>
      <div class="rd-card rd-p2" role="group" aria-roledescription="slide" aria-label="3 of 4: Go" aria-hidden="true">
        <div class="rd-inner">
          <img class="rd-photo" src="{%- render 'tk-src', f: section.settings.img_go, w: 900 -%}" alt="A woman at a doorway, about to walk into a busy room" loading="lazy" width="900" height="1125">
          <div class="rd-shade"></div>
          <span class="rd-num">03 / 04</span>
          <div class="rd-cbody">
            <h3 class="rd-wide rd-ctitle">Go.</h3>
            <p class="rd-cline">Walk in. Press call. Look up.</p>
            <div class="rd-stat"><span class="rd-wide rd-stat-n">10+ hrs</span><span class="rd-serif rd-stat-t">Longer than the moment you were scared of.</span></div>
          </div>
        </div>
      </div>
      <div class="rd-card rd-p3" role="group" aria-roledescription="slide" aria-label="4 of 4: That's the whole ritual" aria-hidden="true">
        <div class="rd-inner rd-cream rd-sum">
          <div class="rd-steps" aria-label="Splash, breathe, go"><span class="rd-step">Splash</span><span class="rd-arrow">→</span><span class="rd-step">Breathe</span><span class="rd-arrow">→</span><span class="rd-step">Go</span></div>
          <p class="rd-wide" style="margin: 0; font-size: 40px; line-height: .92">That's the<br>whole ritual.</p>
          <p class="rd-serif" style="margin: 0; font-size: 32px; line-height: 1.12">Do it every time, and the scent becomes <span style="color: #B3202B">your signal to slow down.</span></p>
        </div>
      </div>
      <div class="rd-hint" aria-hidden="true" data-hint>
        <span class="rd-hand"><svg width="44" height="24" viewBox="0 0 44 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12h38M30 3l10 9-10 9"/></svg></span>
        <span class="rd-hint-t">Swipe to the right</span>
        <span class="rd-hint-s">or tap the card</span>
      </div>
    </div>

    <div style="display: flex; justify-content: space-between; align-items: center">
      <button type="button" class="rd-nav" data-prev aria-label="Previous step"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg></button>
      <div style="display: flex; gap: 6px; align-items: center" aria-hidden="true"><span class="rd-pg rd-pg-on"></span><span class="rd-pg"></span><span class="rd-pg"></span><span class="rd-pg"></span></div>
      <button type="button" class="rd-nav" data-next aria-label="Next step"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg></button>
    </div>
    <script type="application/json" data-moments>{{ section.settings.moments | split: '|' | json }}</script>
  </tk-deck>
</section>
<script>
  if (!customElements.get('tk-deck')) customElements.define('tk-deck', class extends HTMLElement {
    connectedCallback() {
      var cards = this.querySelectorAll('.rd-card'), pgs = this.querySelectorAll('.rd-pg'), deck = this.querySelector('[data-deck]');
      var kicker = this.querySelector('[data-kicker]'), circ = this.querySelector('[data-circ]'), core = this.querySelector('[data-core]'), phase = this.querySelector('[data-phase]');
      var i = 0, busy = false, x0 = null, y0 = 0, dx = 0, drag = false, swiped = false, bt = null, ph = 'idle', sec = 4, round = 0, mi = 0;
      var moments = []; try { moments = JSON.parse(this.querySelector('[data-moments]').textContent).map(function (m) { return m.trim(); }).filter(Boolean); } catch (e) {}
      var letterLine = function () { try { return sessionStorage.getItem('tk-letter-line'); } catch (e) { return null; } };
      var setKicker = function () { var l = letterLine(); kicker.textContent = l ? '“' + l.replace(/^[“"]|[”"]$/g, '') + '”' : (moments[mi % moments.length] || ''); };
      setKicker();
      setInterval(function () { mi++; if (!letterLine()) setKicker(); }, 3000);
      document.addEventListener('tk:letter', setKicker);
      var top = function () { return cards[i]; };
      var layout = function (flying) {
        cards.forEach(function (c, k) {
          var pos = (k - i + 4) % 4;
          c.style.transform = '';
          c.className = 'rd-card rd-p' + pos + (pos === 0 && flying ? (flying === 'right' ? ' rd-fly-r' : ' rd-fly') : '');
          c.setAttribute('aria-hidden', pos === 0 ? 'false' : 'true');
          c.querySelectorAll('button').forEach(function (b) { b.tabIndex = pos === 0 ? 0 : -1; });
        });
        pgs.forEach(function (p, k) { p.className = 'rd-pg' + (k === i ? ' rd-pg-on' : ''); });
      };
      var next = function (dir) {
        if (busy) return; busy = true; layout(dir === 'right' ? 'right' : 'left');
        setTimeout(function () { busy = false; i = (i + 1) % 4; layout(false); }, (window.TK && TK.reduced()) ? 0 : 380);
      };
      var prev = function () { if (!busy) { i = (i + 3) % 4; layout(false); } };
      var renderBreath = function () {
        var active = ph === 'in' || ph === 'out' || ph === 'prep';
        circ.className = ph === 'in' ? 'rd-circ rd-circ-in' : (ph === 'out' || ph === 'prep' ? 'rd-circ' : 'rd-circ rd-circ-idle');
        core.className = active ? 'rd-core' : 'rd-core rd-core-sm';
        core.textContent = active ? sec : (ph === 'done' ? 'AGAIN' : 'START');
        core.setAttribute('aria-label', ph === 'done' ? 'Breathe again' : 'Start three breaths');
        phase.innerHTML = '';
        phase.appendChild(document.createTextNode((ph === 'in' || ph === 'prep') ? 'Breathe in ' : (ph === 'out' ? 'Breathe out ' : (ph === 'done' ? 'Ready. ' : 'Tap the circle '))));
        var s = document.createElement('span'); s.textContent = active ? '· ' + round + ' of 3' : ''; phase.appendChild(s);
      };
      var breathe = function () {
        if (ph === 'in' || ph === 'out' || ph === 'prep') return;
        clearInterval(bt); ph = 'prep'; sec = 4; round = 1; renderBreath();
        setTimeout(function () { ph = 'in'; renderBreath(); }, 40);
        bt = setInterval(function () {
          if (sec > 1) { sec--; renderBreath(); return; }
          if (ph === 'in') { ph = 'out'; sec = 4; renderBreath(); return; }
          if (round < 3) { ph = 'in'; sec = 4; round++; renderBreath(); return; }
          clearInterval(bt); ph = 'done'; renderBreath();
          setTimeout(function () { if (i === 1 && ph === 'done') next(); }, 1200);
        }, 1000);
      };
      core.addEventListener('click', function () { if (swiped) { swiped = false; return; } breathe(); });
      this.querySelector('[data-next]').addEventListener('click', function () { next(); });
      this.querySelector('[data-prev]').addEventListener('click', prev);
      /* Drag the top card: it follows the finger; throw it left or right for the next card.
         A plain tap also moves on, except on the Breathe card, where a tap starts the breathing. */
      deck.addEventListener('pointerdown', function (e) {
        if (busy || (e.pointerType === 'mouse' && e.button !== 0)) return;
        x0 = e.clientX; y0 = e.clientY; dx = 0; drag = false; swiped = false;
      });
      deck.addEventListener('pointermove', function (e) {
        if (x0 == null) return;
        dx = e.clientX - x0;
        if (!drag && Math.abs(dx) > 8 && Math.abs(dx) > Math.abs(e.clientY - y0)) {
          drag = true; top().classList.add('rd-drag');
          try { deck.setPointerCapture(e.pointerId); } catch (er) {}
        }
        if (drag) top().style.transform = 'translateX(' + dx + 'px) rotate(' + (dx / 18) + 'deg)';
      });
      var release = function (e, cancelled) {
        if (x0 == null) return;
        var moved = Math.abs(dx) > 8 || Math.abs(e.clientY - y0) > 8, wasDrag = drag;
        x0 = null; drag = false; top().classList.remove('rd-drag');
        if (wasDrag) {
          swiped = true; setTimeout(function () { swiped = false; }, 300);
          if (!cancelled && Math.abs(dx) > 60) next(dx > 0 ? 'right' : 'left'); else top().style.transform = '';
          return;
        }
        if (cancelled || moved) return;
        if (e.target.closest('[data-core]')) return;           // the circle button handles its own tap
        if (i === 1) breathe(); else next();
      };
      deck.addEventListener('pointerup', function (e) { release(e, false); });
      deck.addEventListener('pointercancel', function (e) { release(e, true); });

      /* First time the deck comes into view: a short "swipe" overlay, gone after about a second. */
      var hint = this.querySelector('[data-hint]');
      if (hint && 'IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (en) {
          if (!en[0].isIntersecting) return; io.disconnect();
          hint.classList.add('rd-hint-on');
          setTimeout(function () { hint.classList.remove('rd-hint-on'); }, 1300);
        }, { threshold: 0.6 });
        io.observe(deck);
      }
      layout(false);
    }
  });
</script>

{% schema %}
{
  "name": "TEKILA ritual deck",
  "settings": [
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Three steps. The same three, every time, until your body knows the way." },
    { "type": "text", "id": "moments", "label": "Card 1 rotating lines (separate with |)", "default": "Before the room.|Before the date.|Before the call.|Before the presentation.", "info": "After a visitor seals a Carta, card 1 shows a line from their letter instead." },
    { "type": "text", "id": "img_splash", "label": "Splash photo (file name or URL)", "default": "img-3.jpg" },
    { "type": "text", "id": "img_go", "label": "Go photo (file name or URL)", "default": "img-8.jpg" }
  ],
  "presets": [{ "name": "TEKILA ritual deck" }]
}
{% endschema %}
