{%- liquid
  assign p = all_products['tekila-anxiety']
  assign ritual_price = 180000
  assign passport_price = 250000
  for v in p.variants
    assign t = v.title | downcase
    if t contains 'passport'
      assign passport_price = v.price
    elsif t contains 'ritual'
      assign ritual_price = v.price
    endif
  endfor
-%}
{%- style -%}

.rd-wide{font-stretch:125%;font-weight:900;text-transform:uppercase;letter-spacing:-0.01em}
.rd-serif{font-family:var(--tk-f-serif);font-weight:400;font-style:italic;text-transform:none;font-stretch:100%;letter-spacing:0}
.rd-lead{display:flex;align-items:center;gap:12px;font-size:24px;line-height:1}
.rd-lead::before{content:'';width:28px;height:2px;background:#E9A93C;flex:none}
.rd-big{display:block;font-size:66px;line-height:.86}
.rd-outline{color:transparent;-webkit-text-stroke:2px #E9A93C}
.rd-before{display:block;font-size:34px;line-height:1.05;margin-top:10px}
.rd-deck{position:relative;height:540px;margin:0 6px 40px;touch-action:pan-y;user-select:none;-webkit-user-select:none}
.rd-card{position:absolute;inset:0;border-radius:24px;overflow:hidden;display:flex;flex-direction:column;background:#0E0B09;color:#F4EADA;box-shadow:0 18px 40px rgba(0,0,0,.5);border:1.5px solid rgba(244,234,218,.12);transition:transform .45s cubic-bezier(.3,.1,.2,1),opacity .4s,background-color .45s}
.rd-p0{z-index:3}
.rd-p1{z-index:2;background:#E9A93C;border-color:#E9A93C;transform:translate(14px,18px) scale(.95) rotate(4deg)}
.rd-p2{z-index:1;background:#D8C3A0;border-color:#D8C3A0;transform:translate(-12px,32px) scale(.91) rotate(-5deg)}
.rd-p3{z-index:0;opacity:0;transform:translateY(32px) scale(.9)}
.rd-cream{background:#F4EADA;color:#171310}
.rd-p1 .rd-inner,.rd-p2 .rd-inner,.rd-p3 .rd-inner{opacity:0}
.rd-inner{position:absolute;inset:0;display:flex;flex-direction:column;transition:opacity .4s}
.rd-photo{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.rd-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(14,11,9,0) 25%,rgba(14,11,9,.55) 52%,rgba(14,11,9,.96) 100%)}
.rd-num{position:absolute;left:16px;top:14px;z-index:2;font:600 12px var(--tk-f-mono);letter-spacing:.12em;color:#F4EADA;background:rgba(14,11,9,.6);padding:5px 9px;border-radius:999px}
.rd-cbody{position:relative;z-index:2;margin-top:auto;padding:22px;display:flex;flex-direction:column;gap:12px}
.rd-ctitle{margin:0;font-size:72px;line-height:.85}
.rd-cline{margin:0;font-size:17px;font-weight:700;line-height:1.35}
.rd-stat{display:flex;flex-direction:column;gap:6px;border-top:1.5px solid rgba(244,234,218,.3);padding-top:14px}
.rd-stat-n{font-size:28px;line-height:1;color:#E9A93C}
.rd-stat-t{font-size:20px;line-height:1.15}
.rd-breath{position:relative;flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;padding-top:24px}
.rd-circwrap{position:relative;width:180px;height:180px;display:grid;place-items:center}
.rd-circ{position:absolute;inset:0;border-radius:50%;background:radial-gradient(circle at 40% 35%,#F2BC5A,#E9A93C 45%,#C9861A);transform:scale(.45);transition:transform 4s ease-in-out;box-shadow:0 0 60px rgba(233,169,60,.35)}
.rd-circ-in{transform:scale(1)}
.rd-circ-idle{animation:rdIdle 3s ease-in-out infinite}
@keyframes rdIdle{0%,100%{transform:scale(.45)}50%{transform:scale(.5)}}
.rd-core{position:relative;z-index:1;width:84px;height:84px;border-radius:50%;border:0;background:transparent;cursor:pointer;display:grid;place-items:center;color:#0E0B09;font:900 38px var(--tk-f-sans);font-stretch:125%;line-height:1;padding:0}
.rd-core-sm{font-size:13px;letter-spacing:.06em}
.rd-phase{font:900 14px var(--tk-f-sans);font-stretch:125%;letter-spacing:.12em;text-transform:uppercase;color:#E9A93C;min-height:18px;margin:0;text-align:center}
.rd-phase span{color:#F4EADA;opacity:.75;font-family:var(--tk-f-mono);font-weight:600;font-stretch:100%;letter-spacing:.04em}
.rd-nav{width:48px;height:48px;border-radius:50%;border:1.5px solid rgba(244,234,218,.4);background:transparent;color:#F4EADA;cursor:pointer;display:flex;align-items:center;justify-content:center}
.rd-pg{width:8px;height:8px;border-radius:50%;background:rgba(244,234,218,.3);transition:all .25s}
.rd-pg-on{background:#E9A93C;width:24px;border-radius:4px}
.rd-steps{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.rd-sum{justify-content:center;gap:22px;padding:28px 24px}
.rd-step{font:900 12px var(--tk-f-sans);font-stretch:125%;letter-spacing:.06em;text-transform:uppercase;border:1.5px solid #171310;border-radius:999px;padding:6px 10px}
.rd-arrow{font:600 12px var(--tk-f-mono);opacity:.5}
/* story deck v2: 5 cards, no recycling */
.rd-gone{z-index:4;opacity:0;pointer-events:none;transform:translateX(-130%) rotate(-14deg)!important}
.rd-gone-r{transform:translateX(130%) rotate(14deg)!important}
.rd-p3,.rd-p4{z-index:0;opacity:0;transform:translateY(32px) scale(.9);pointer-events:none}
.rd-p3 .rd-inner,.rd-p4 .rd-inner{opacity:0}
.rd-p1,.rd-p2{pointer-events:none}
.rd-drag{transition:none!important}
.rd-deck{cursor:grab}
.rd-nope{animation:rdNope .4s ease}
@keyframes rdNope{25%{transform:translateX(-10px) rotate(-2deg)}75%{transform:translateX(10px) rotate(2deg)}}
.rd-kraft{background:#D8C3A0;color:#171310}
.rd-head{display:flex;flex-direction:column;gap:6px;padding:22px 22px 0;position:relative;z-index:2}
.rd-tap{position:absolute;left:50%;bottom:100%;margin-bottom:22px;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:2px;white-space:nowrap;font:800 14px var(--tk-f-sans);color:#B3202B;pointer-events:none;z-index:5;animation:rdBob 1.2s ease-in-out infinite;transition:opacity .25s}
.rd-tap-off{opacity:0;animation:none}
@keyframes rdBob{0%,100%{transform:translate(-50%,0)}50%{transform:translate(-50%,6px)}}
@keyframes rdPulse{0%,100%{transform:scale(1)}50%{transform:scale(1.04)}}
.rd-dots{display:flex;gap:8px;align-items:center}
.rd-dot{width:14px;height:14px;border-radius:50%;border:2px solid #171310;transition:background .2s}
.rd-dot-on{background:#B3202B;border-color:#B3202B}
.rd-bottle{position:absolute;left:50%;bottom:0;width:190px;transform:translate(-50%,30%)}
.rd-bottle .tk-bottle{display:block;position:relative}
.rd-bottle .tk-bottle img{display:block;width:100%;height:auto;position:relative}
.rd-bottle .rd-act{z-index:1}.rd-bottle .rd-body{z-index:2}
.rd-press-a{animation:rdPressA .32s cubic-bezier(.3,0,.3,1)}.rd-press-b{animation:rdPressB .32s cubic-bezier(.3,0,.3,1)}
@keyframes rdPressA{0%,100%{transform:translateY(0)}40%{transform:translateY(30%)}}
@keyframes rdPressB{0%,100%{transform:translateY(0)}40%{transform:translateY(30%)}}
.rd-nozzle{position:absolute;left:50%;top:0;width:96px;height:96px;margin:-30px 0 0 -48px;border-radius:50%;border:0;background:transparent;cursor:pointer;z-index:4}
.rd-nozzle::before{content:'';position:absolute;inset:14px;border-radius:50%;border:2px solid #B3202B;animation:rdRing 1.6s ease-out infinite}
@keyframes rdRing{0%{transform:scale(.4);opacity:1}100%{transform:scale(1.25);opacity:0}}
.rd-puff{position:absolute;left:48.5%;top:3%;width:26px;height:26px;margin:-13px 0 0 -13px;border-radius:50%;background:radial-gradient(circle,rgba(179,32,43,.45),rgba(179,32,43,0) 70%);pointer-events:none;z-index:3;animation:rdPuff 1.4s ease-out forwards}
@keyframes rdPuff{0%{transform:translate(0,0) scale(.3);opacity:1}100%{transform:translate(var(--dx),var(--dy)) scale(var(--s));opacity:0}}
.rd-video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.rd-snd{position:absolute;right:14px;top:12px;z-index:3;width:44px;height:44px;border-radius:50%;border:0;background:rgba(14,11,9,.6);color:#F4EADA;cursor:pointer;display:grid;place-items:center}
.rd-snd .tk-i-on{display:none}.rd-snd[aria-pressed="true"] .tk-i-on{display:block}.rd-snd[aria-pressed="true"] .tk-i-off{display:none}
.tk .rd-seat{display:flex;align-items:center;gap:12px;background:#E9A93C;color:#171310;border-radius:16px;padding:14px 16px;text-decoration:none;border:2px dashed rgba(23,19,16,.55);font:900 17px var(--tk-f-sans);font-stretch:125%;text-transform:uppercase;line-height:1.05;box-shadow:0 10px 24px rgba(0,0,0,.35);animation:rdWiggle 3.2s ease-in-out infinite}
.tk .rd-seat:hover{color:#171310;background:#F2BC5A}
.rd-seat small{display:block;margin-top:4px;font:600 11px var(--tk-f-mono);text-transform:none;letter-spacing:.02em;opacity:.8}
@keyframes rdWiggle{0%,88%,100%{transform:rotate(0)}91%{transform:rotate(-2deg)}94%{transform:rotate(2deg)}97%{transform:rotate(-1deg)}}
.rd-way{display:flex;justify-content:space-between;align-items:baseline;gap:12px;border-top:1.5px solid rgba(23,19,16,.18);padding-top:12px}
.rd-way b{font:900 20px var(--tk-f-sans);font-stretch:125%;text-transform:uppercase}
.rd-way span{font:600 14px var(--tk-f-mono)}
.rd-way p{margin:4px 0 0;font-size:14px;line-height:1.35;opacity:.8}
.tk .rd-btn{display:flex;align-items:center;justify-content:center;min-height:54px;border-radius:999px;background:#171310;color:#F4EADA;text-decoration:none;font:700 16px var(--tk-f-sans);margin-top:auto}
.tk .rd-btn:hover{background:#B3202B;color:#fff}
.rd-end{position:absolute;inset:0;border:2px dashed rgba(244,234,218,.25);border-radius:24px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;text-align:center;padding:24px;z-index:0}
.rd-again{border:0;background:none;color:#F4EADA;font:600 14px var(--tk-f-mono);text-decoration:underline;cursor:pointer;padding:8px}
.rd-hint{position:absolute;inset:0;z-index:6;border-radius:24px;background:rgba(14,11,9,.55);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;color:#F4EADA;pointer-events:none;opacity:0;transition:opacity .35s ease}
.rd-hint-on{opacity:1}
.rd-hint-t{padding:0 20px;text-align:center;font:900 18px var(--tk-f-sans);font-stretch:125%;letter-spacing:.04em;text-transform:uppercase}
.rd-hand{display:flex;align-items:center;gap:6px;color:#E9A93C;animation:rdSwipe 1.1s ease-in-out infinite}
@keyframes rdSwipe{0%{transform:translateX(26px);opacity:.3}60%{transform:translateX(-26px);opacity:1}100%{transform:translateX(-26px);opacity:0}}
.rd-nav:disabled{opacity:.3;cursor:not-allowed}

{%- endstyle -%}
<section id="ritual" aria-labelledby="rd-h-{{ section.id }}" style="background: #171310; color: #F4EADA; padding: 56px 20px 64px">
  <tk-deck style="max-width: 480px; margin: 0 auto; display: flex; flex-direction: column; gap: 22px">
    <div style="display: flex; flex-direction: column; gap: 10px">
      <h2 id="rd-h-{{ section.id }}" style="margin: 0; display: flex; flex-direction: column; gap: 4px">
        <span class="rd-wide" style="font-size: 44px; line-height: .9">{{ section.settings.heading_a }}</span>
        <span class="rd-serif" style="font-size: 44px; line-height: .95; color: #E9A93C">{{ section.settings.heading_b }}</span>
      </h2>
      <p style="margin: 0; font-size: 16px; line-height: 1.5; color: rgba(244,234,218,.8)">{{ section.settings.intro }}</p>
    </div>

    <div class="rd-deck" data-deck role="group" aria-roledescription="carousel" aria-label="The ritual in four cards">
      <div class="rd-end" data-end hidden>
        <p class="rd-wide" style="margin: 0; font-size: 28px; line-height: .95">That’s the ritual.</p>
        <p class="rd-serif" style="margin: 0; font-size: 22px; color: #E9A93C">Now pick your way in.</p>
        <a href="#reserve" class="rd-btn" style="margin: 6px 0 0; padding: 0 28px; background: #F4EADA; color: #171310" data-track="deck_end_choose">Choose yours ↓</a>
        <button type="button" class="rd-again" data-again>↺ Do the ritual again</button>
      </div>

      {%- comment -%} 1. Splash: tap the nozzle 3 times (can't be swiped until done) {%- endcomment -%}
      <div class="rd-card" role="group" aria-roledescription="slide" aria-label="1 of 4: Splash">
        <div class="rd-inner rd-kraft">
          <span class="rd-num" style="background: rgba(23,19,16,.75)">01 / 04</span>
          <div class="rd-head" style="padding-top: 54px">
            <h3 class="rd-wide rd-ctitle" style="font-size: 50px">Splash.</h3>
            <p class="rd-cline" data-kicker>Before the room.</p>
            <div class="rd-dots" aria-live="polite"><span class="rd-dot"></span><span class="rd-dot"></span><span class="rd-dot"></span><span class="rd-mono mono" style="font-size: 13px; margin-left: 4px"><span data-splash-n>0</span> / 3</span></div>
          </div>
          <div class="rd-bottle" data-bottle>
            <span class="rd-tap" data-tap-hint aria-hidden="true">Tap the nozzle<svg width="18" height="22" viewBox="0 0 18 22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 2v17M3 13l6 6 6-6"/></svg></span>
            <button type="button" class="rd-nozzle" data-nozzle aria-label="Press the nozzle (3 times)"></button>
            {%- render 'tk-bottle', act_cls: 'rd-act', body_cls: 'rd-body', alt: 'TEKILA Anxiety bottle', w: 500 -%}
          </div>
        </div>
      </div>

      {%- comment -%} 2. Breathe {%- endcomment -%}
      <div class="rd-card" role="group" aria-roledescription="slide" aria-label="2 of 4: Breathe" aria-hidden="true">
        <div class="rd-inner">
          <span class="rd-num">02 / 04</span>
          <div class="rd-breath">
            <div class="rd-circwrap">
              <div class="rd-circ rd-circ-idle" data-circ></div>
              <button type="button" class="rd-core rd-core-sm" data-core aria-label="Start one breath" tabindex="-1">START</button>
            </div>
            <p class="rd-phase" aria-live="polite" data-phase>Tap the circle <span></span></p>
          </div>
          <div class="rd-cbody" style="margin-top: 0">
            <h3 class="rd-wide rd-ctitle">Breathe.</h3>
            <p class="rd-cline">In for four. Out for four.</p>
            <div class="rd-stat"><span class="rd-wide rd-stat-n">3 breaths</span><span class="rd-serif rd-stat-t">The scent settles as you do. Only you can smell it.</span></div>
          </div>
        </div>
      </div>

      {%- comment -%} 3. Go {%- endcomment -%}
      <div class="rd-card" role="group" aria-roledescription="slide" aria-label="3 of 4: Go" aria-hidden="true">
        <div class="rd-inner">
          <img class="rd-photo" src="{%- render 'tk-src', f: section.settings.img_go, w: 900 -%}" alt="A woman at a doorway, about to walk into a busy room" loading="lazy" width="900" height="1125">
          <div class="rd-shade"></div>
          <span class="rd-num">03 / 04</span>
          <div class="rd-cbody">
            <h3 class="rd-wide rd-ctitle">Go.</h3>
            <p class="rd-cline">Walk in. Press call. Look up.</p>
            <div class="rd-stat"><span class="rd-wide rd-stat-n">10+ hrs</span><span class="rd-serif rd-stat-t">Longer than the moment you were scared of.</span></div>
          </div>
        </div>
      </div>

      {%- comment -%} 4. Not alone: the gatherings + free seat {%- endcomment -%}
      <div class="rd-card" role="group" aria-roledescription="slide" aria-label="4 of 4: Not alone" aria-hidden="true">
        <div class="rd-inner">
          {%- liquid
            assign clips = ''
            if section.settings.gather_video != blank
              capture one
                render 'tk-media', file: section.settings.gather_video
              endcapture
              assign clips = one | strip
            else
              assign names = section.settings.gather_clips | default: section.settings.gather_file | split: ','
              for n in names
                assign nm = n | strip
                if nm != blank
                  capture u
                    render 'tk-src', f: nm
                  endcapture
                  assign clips = clips | append: u | strip | append: '|'
                endif
              endfor
            endif
            assign playlist = clips | split: '|'
          -%}
          <script type="application/json" data-playlist>{{ playlist | json }}</script>
          <video class="rd-video" muted playsinline {% if playlist.size < 2 %}loop {% endif %}preload="none" data-tk-loop
            data-src="{{ playlist.first }}"
            poster="{%- if section.settings.gather_poster != blank -%}{%- render 'tk-media', file: section.settings.gather_poster, want: 'poster', w: 900 -%}{%- elsif section.settings.gather_video != blank -%}{%- render 'tk-media', file: section.settings.gather_video, want: 'poster', w: 900 -%}{%- else -%}{%- render 'tk-src', f: section.settings.gather_poster_file, w: 900 -%}{%- endif -%}"
            aria-label="A TEKILA gathering"></video>
          <div class="rd-shade"></div>
          <span class="rd-num">04 / 04</span>
          <button type="button" class="rd-snd" aria-pressed="false" aria-label="Turn sound on" data-snd tabindex="-1">
            <svg class="tk-i-off" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4z"></path><path d="m23 9-6 6"></path><path d="m17 9 6 6"></path></svg>
            <svg class="tk-i-on" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4z"></path><path d="M15.5 8.5a5 5 0 0 1 0 7"></path></svg>
          </button>
          <div class="rd-cbody">
            <h3 class="rd-wide rd-ctitle" style="font-size: 54px">Not alone.</h3>
            <p class="rd-cline">{{ section.settings.gather_line }}</p>
            <a href="#cartas" class="rd-seat" data-seat-link data-track="deck_seat_tap" tabindex="-1"><span aria-hidden="true" style="font-size: 26px">🎟</span><span>{{ section.settings.seat_cta }}</span></a>
          </div>
        </div>
      </div>

      <div class="rd-hint" aria-hidden="true" data-hint>
        <span class="rd-hand"><svg width="44" height="24" viewBox="0 0 44 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M42 12H4M14 3L4 12l10 9"/></svg></span>
        <span class="rd-hint-t">Swipe to continue</span>
      </div>
    </div>

    <div style="display: flex; justify-content: space-between; align-items: center">
      <button type="button" class="rd-nav" data-prev aria-label="Previous card"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg></button>
      <div style="display: flex; gap: 6px; align-items: center" aria-hidden="true">{%- for i in (1..4) -%}<span class="rd-pg"></span>{%- endfor -%}</div>
      <button type="button" class="rd-nav" data-next aria-label="Next card"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg></button>
    </div>
    <script type="application/json" data-moments>{{ section.settings.moments | split: '|' | json }}</script>
  </tk-deck>
</section>
<script>
  if (!customElements.get('tk-deck')) customElements.define('tk-deck', class extends HTMLElement {
    connectedCallback() {
      var self = this, cards = this.querySelectorAll('.rd-card'), N = cards.length, pgs = this.querySelectorAll('.rd-pg'), deck = this.querySelector('[data-deck]');
      var kicker = this.querySelector('[data-kicker]'), circ = this.querySelector('[data-circ]'), core = this.querySelector('[data-core]'), phase = this.querySelector('[data-phase]');
      var end = this.querySelector('[data-end]'), hint = this.querySelector('[data-hint]'), nextBtn = this.querySelector('[data-next]'), prevBtn = this.querySelector('[data-prev]');
      var i = 0, busy = false, x0 = null, y0 = 0, dx = 0, drag = false, swiped = false, bt = null, ph = 'idle', sec = 4, round = 0, mi = 0, splashes = 0, hinted = false;
      var dirs = [];   // which side each card flew to
      var track = function (n) { if (window.TK && TK.track) TK.track(n); };
      var moments = []; try { moments = JSON.parse(this.querySelector('[data-moments]').textContent).map(function (m) { return m.trim(); }).filter(Boolean); } catch (e) {}
      var letterLine = function () { try { return sessionStorage.getItem('tk-letter-line'); } catch (e) { return null; } };
      var setKicker = function () { var l = letterLine(); kicker.textContent = l ? '“' + l.replace(/^[“"]|[”"]$/g, '') + '”' : (moments[mi % moments.length] || ''); };
      setKicker(); setInterval(function () { mi++; if (!letterLine()) setKicker(); }, 3000);
      document.addEventListener('tk:letter', setKicker);
      var locked = function () { return i === 0 && splashes < 3; };   // card 1 needs the 3 splashes
      var top = function () { return cards[i]; };

      var layout = function () {
        cards.forEach(function (c, k) {
          var pos = k - i;
          c.style.transform = '';
          c.className = 'rd-card ' + (pos < 0 ? 'rd-gone' + (dirs[k] === 'right' ? ' rd-gone-r' : '') : 'rd-p' + Math.min(pos, 4));
          c.setAttribute('aria-hidden', pos === 0 ? 'false' : 'true');
          c.querySelectorAll('button, a').forEach(function (b) { b.tabIndex = pos === 0 ? 0 : -1; });
        });
        pgs.forEach(function (p, k) { p.className = 'rd-pg' + (k === i ? ' rd-pg-on' : ''); });
        end.hidden = i < N;
        prevBtn.disabled = i === 0;
        nextBtn.disabled = i >= N || locked();
        if (i === 2 && !hinted) showHint();
        var v = cards[3] && cards[3].querySelector('video');
