{%- style -%}
.pd-gather{background:#171310;color:#F4EADA;padding:32px 20px}
.pd-gather-in{max-width:520px;margin:0 auto;display:flex;flex-direction:column;gap:16px}
.pd-stage{position:relative;aspect-ratio:4/5;border-radius:20px;overflow:hidden;background:#000}
.pd-stage video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.pd-cap{position:absolute;left:14px;bottom:14px;right:60px;font-family:var(--tk-f-serif);font-style:italic;font-size:24px;line-height:1.1;text-shadow:0 2px 12px rgba(0,0,0,.7)}
.pd-snd{position:absolute;right:12px;bottom:12px;width:44px;height:44px;border-radius:50%;border:0;background:rgba(14,11,9,.6);color:#F4EADA;cursor:pointer;display:grid;place-items:center}
.pd-snd .tk-i-on{display:none}.pd-snd[aria-pressed="true"] .tk-i-on{display:block}.pd-snd[aria-pressed="true"] .tk-i-off{display:none}
.pd-reel{display:flex;gap:10px;overflow-x:auto;margin:0 -20px;padding:0 20px 4px;scrollbar-width:none;scroll-snap-type:x proximity;list-style:none}
.pd-reel::-webkit-scrollbar{display:none}
.pd-reel li{flex:0 0 108px;scroll-snap-align:start}
.pd-clip{position:relative;display:block;width:100%;aspect-ratio:9/16;border-radius:14px;overflow:hidden;border:2px solid transparent;padding:0;cursor:pointer;background:#000}
.pd-clip img{width:100%;height:100%;object-fit:cover;display:block;opacity:.85}
.pd-clip span{position:absolute;left:8px;right:8px;bottom:8px;font:700 12px var(--tk-f-sans);color:#F4EADA;text-align:left;text-shadow:0 1px 6px rgba(0,0,0,.8)}
.pd-clip[aria-pressed="true"]{border-color:#E9A93C}
{%- endstyle -%}
<section id="gatherings" class="pd-gather" aria-labelledby="gt-h-{{ section.id }}">
  <tk-gather class="pd-gather-in">
    <h2 id="gt-h-{{ section.id }}" style="margin: 0; display: flex; flex-direction: column; gap: 2px">
      <span class="pd-serif" style="font-size: 28px; line-height: 1; color: #E9A93C">{{ section.settings.heading_a }}</span>
      <span class="pd-wide" style="font-size: 34px; line-height: .95">{{ section.settings.heading_b }}</span>
    </h2>
    <p style="margin: 0; font-size: 15px; line-height: 1.5; opacity: .8">{{ section.settings.text }}</p>
    <div class="pd-stage">
      <video muted playsinline loop preload="none" data-tk-loop
        data-src="{%- render 'tk-src', f: section.settings.loop_video -%}"
        poster="{%- render 'tk-src', f: section.settings.loop_poster, w: 900 -%}"
        aria-label="Gathering highlights"></video>
      <span class="pd-cap" data-cap>{{ section.settings.loop_caption }}</span>
      <button type="button" class="pd-snd" aria-pressed="false" aria-label="Turn sound on" data-snd>
        <svg class="tk-i-off" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4z"></path><path d="m23 9-6 6"></path><path d="m17 9 6 6"></path></svg>
        <svg class="tk-i-on" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4z"></path><path d="M15.5 8.5a5 5 0 0 1 0 7"></path></svg>
      </button>
    </div>
    <ul class="pd-reel" aria-label="Gathering clips" style="margin: 0">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          <button type="button" class="pd-clip" aria-pressed="false" aria-label="Play with sound: {{ block.settings.caption | escape }}"
            data-clip="{%- render 'tk-src', f: block.settings.video -%}"
            data-poster="{%- render 'tk-src', f: block.settings.poster, w: 900 -%}"
            data-cap="{{ block.settings.caption | escape }}">
            <img src="{%- render 'tk-src', f: block.settings.poster, w: 240 -%}" alt="" loading="lazy" width="108" height="192"><span>{{ block.settings.caption }}</span>
          </button>
        </li>
      {%- endfor -%}
    </ul>
  </tk-gather>
</section>
<script>
  if (!customElements.get('tk-gather')) customElements.define('tk-gather', class extends HTMLElement {
    connectedCallback() {
      var v = this.querySelector('video'), cap = this.querySelector('[data-cap]'), snd = this.querySelector('[data-snd]'), clips = this.querySelectorAll('[data-clip]');
      var setSound = function (on) {
        snd.setAttribute('aria-pressed', on ? 'true' : 'false'); snd.setAttribute('aria-label', on ? 'Mute' : 'Turn sound on');
        if (on) { if (window.TK) { TK.claimSound(v); if (TK.muted) TK.setMuted(false); } v.removeAttribute('data-tk-loop'); }
        v.muted = !on; window.TK ? TK.play(v) : v.play();
      };
      snd.addEventListener('click', function () { setSound(v.muted); });
      clips.forEach(function (b) {
        b.addEventListener('click', function () {
          clips.forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
          v.dataset.src = b.dataset.clip; v.src = b.dataset.clip; v.poster = b.dataset.poster; cap.textContent = b.dataset.cap;
          setSound(true);
        });
      });
      var off = function () { snd.setAttribute('aria-pressed', 'false'); snd.setAttribute('aria-label', 'Turn sound on'); };
      document.addEventListener('tk:sound', function (e) { if (e.detail.owner !== v && !v.muted) { v.muted = true; off(); } });
      document.addEventListener('tk:mute', function (e) { if (e.detail.muted) off(); });
    }
  });
</script>

{% schema %}
{
  "name": "TEKILA gatherings",
  "settings": [
    { "type": "text", "id": "heading_a", "label": "Heading, serif", "default": "Every month," },
    { "type": "text", "id": "heading_b", "label": "Heading, wide", "default": "a room full of strangers." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Games, dancing, letters and a lot of noise. Passport holders get a seat at every one." },
    { "type": "text", "id": "loop_video", "label": "Silent loop video (file name or URL)", "default": "gather-compilation.mp4" },
    { "type": "text", "id": "loop_poster", "label": "Loop poster (file name or URL)", "default": "gather-compilation.jpg" },
    { "type": "text", "id": "loop_caption", "label": "Loop caption", "default": "Gathering Nº 06" }
  ],
  "blocks": [
    {
      "type": "clip",
      "name": "Clip",
      "settings": [
        { "type": "text", "id": "video", "label": "Video (file name or URL)" },
        { "type": "text", "id": "poster", "label": "Poster (file name or URL)" },
        { "type": "text", "id": "caption", "label": "Caption" }
      ]
    }
  ],
  "presets": [{ "name": "TEKILA gatherings" }]
}
{% endschema %}
