{%- style -%}
.sbar{position:fixed;left:12px;right:12px;bottom:12px;z-index:49;max-width:520px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:8px 8px 8px 18px;border-radius:999px;background:rgba(23,19,16,.92);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);color:#F4EADA;box-shadow:0 8px 24px rgba(0,0,0,.25);transform:translateY(150%);opacity:0;visibility:hidden;transition:transform .35s ease,opacity .35s ease,visibility 0s .35s}
.sbar-on{transform:none;opacity:1;visibility:visible;transition:transform .35s ease,opacity .35s ease}
.tk .sbar a{min-height:44px;padding:0 22px;border-radius:999px;background:#F4EADA;color:#171310;font-weight:700;font-size:15px;display:flex;align-items:center;text-decoration:none}
.tk .sbar a:hover{background:#fff;color:#171310}
@media (min-width:900px){.sbar{display:none}}
{%- endstyle -%}
<tk-sbar class="sbar" role="region" aria-label="Reserve">
  <span class="mono" style="font-size: 12px; line-height: 1.3"><span style="opacity: .7">Batch <tk-time format="batch">01</tk-time> closes in</span><br><strong style="font-size: 14px"><tk-time format="short">Thursday</tk-time></strong></span>
  <a href="#reserve">{{ section.settings.cta }}</a>
</tk-sbar>
<script>
  if (!customElements.get('tk-sbar')) customElements.define('tk-sbar', class extends HTMLElement {
    connectedCallback() {
      var bar = this, raf = 0;
      var inView = function (el) { if (!el) return false; var r = el.getBoundingClientRect(); return r.top < innerHeight && r.bottom > 0; };
      var check = function () {
        raf = 0;
        var hero = document.getElementById('top'), on = false;
        if (!document.documentElement.classList.contains('tk-intro-on') && hero) {
          on = hero.getBoundingClientRect().bottom < 0 && !inView(document.getElementById('reserve')) && !inView(document.getElementById('tk-footer'));
        }
        bar.classList.toggle('sbar-on', on);
        document.body.classList.toggle('tk-bar-on', on && innerWidth < 900);
      };
      var sched = function () { if (!raf) raf = requestAnimationFrame(check); };
      addEventListener('scroll', sched, { passive: true }); addEventListener('resize', sched);
      document.addEventListener('tk:intro-done', sched);
      check();
    }
  });
</script>

{% schema %}
{
  "name": "TEKILA sticky reserve bar",
  "settings": [
    { "type": "paragraph", "content": "Mobile only. Hidden on the hero, on the Ritual or Passport section and on the footer." },
    { "type": "text", "id": "cta", "label": "Button", "default": "Reserve" }
  ],
  "presets": [{ "name": "TEKILA sticky reserve bar" }]
}
{% endschema %}
