{%- style -%}
.cb-wide{font-stretch:125%;font-weight:900;text-transform:uppercase;letter-spacing:-0.01em}
.cb-serif{font-family:var(--tk-f-serif);font-weight:400;font-style:italic;text-transform:none;font-stretch:100%;letter-spacing:0}
.cb-mono{font-family:var(--tk-f-mono)}
.cb-switch{position:relative;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));background:#171310;border-radius:999px;padding:5px}
.cb-knob{position:absolute;top:5px;bottom:5px;left:5px;width:calc(50% - 5px);border-radius:999px;background:#F4EADA;transition:transform .35s cubic-bezier(.3,1.3,.5,1)}
.cb-knob-r{transform:translateX(100%)}
.cb-opt{position:relative;z-index:1;border:0;background:transparent;min-height:52px;border-radius:999px;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px;color:#F4EADA;transition:color .3s}
.cb-opt[aria-checked="true"]{color:#171310}
.cb-opt-name{font:900 14px var(--tk-f-sans);font-stretch:125%;text-transform:uppercase;letter-spacing:.02em}
.cb-opt-price{font:600 11px var(--tk-f-mono);opacity:.75}
.cb-scene{position:relative;height:360px;margin-top:6px}
.cb-back{position:absolute;left:8%;right:8%;bottom:0;height:150px;background:#B8996B;border-radius:6px 6px 10px 10px}
.cb-front{position:absolute;left:6%;right:6%;bottom:0;height:118px;z-index:20;background:linear-gradient(180deg,#C9AA7A,#BB9C6C);border-radius:4px 4px 12px 12px;box-shadow:0 14px 30px rgba(23,19,16,.25);display:flex;align-items:center;justify-content:center;flex-direction:column;gap:4px;cursor:pointer;border:0;padding:0;width:auto}
.cb-front-mark{font:900 26px var(--tk-f-sans);font-stretch:125%;text-transform:uppercase;color:rgba(23,19,16,.78);letter-spacing:.02em}
.cb-front-sub{font:600 10px var(--tk-f-mono);letter-spacing:.14em;color:rgba(23,19,16,.6)}
.cb-flap{position:absolute;left:8%;right:8%;bottom:150px;height:46px;background:#A88A5D;transform-origin:bottom center;border-radius:6px 6px 0 0;transition:transform .7s cubic-bezier(.3,1.2,.5,1);z-index:1}
.cb-flap-shut{transform:rotateX(0);z-index:25;bottom:110px;height:52px;background:#C2A374}
.cb-flap-open{transform:perspective(500px) rotateX(-160deg)}
.cb-item{position:absolute;bottom:60px;transition:transform .7s cubic-bezier(.3,1.25,.5,1),opacity .45s;transform-origin:bottom center;transform:translate(0,90px);opacity:0}
.cb-bottle{left:50%;width:96px;margin-left:-48px;z-index:12}
.cb-letter{left:9%;width:118px;height:84px;z-index:9;background:#F4EADA;border-radius:4px;box-shadow:0 6px 16px rgba(23,19,16,.25);overflow:hidden}
.cb-letter::before{content:'';position:absolute;left:0;right:0;top:0;height:50px;background:linear-gradient(160deg,transparent 49%,#E6D8BE 50%),linear-gradient(200deg,transparent 49%,#E6D8BE 50%);background-size:50% 100%;background-position:left,right;background-repeat:no-repeat}
.cb-wax{position:absolute;left:50%;top:32px;margin-left:-15px;width:30px;height:30px;border-radius:50%;background:radial-gradient(circle at 35% 35%,#D7333E,#9E1A24);color:#F4EADA;font:900 14px var(--tk-f-sans);display:grid;place-items:center}
.cb-pass{right:7%;width:122px;height:162px;z-index:10;background:#171310;color:#F4EADA;border-radius:6px 10px 10px 6px;box-shadow:0 8px 20px rgba(23,19,16,.35);padding:12px 10px;display:flex;flex-direction:column;gap:6px;overflow:hidden}
.cb-pass::before{content:'';position:absolute;left:8px;top:0;bottom:0;width:1px;background:rgba(244,234,218,.15)}
.cb-contract{left:22%;width:110px;height:140px;z-index:6;background:#FBF6EC;border-radius:3px;box-shadow:0 6px 16px rgba(23,19,16,.2);padding:12px 10px;display:flex;flex-direction:column;gap:6px}
.cb-rule{height:3px;border-radius:2px;background:rgba(23,19,16,.14)}
.cb-card{right:20%;width:104px;height:66px;z-index:7;background:#E9A93C;border-radius:8px;box-shadow:0 6px 14px rgba(23,19,16,.25);padding:8px;display:flex;flex-direction:column;justify-content:space-between}
.cb-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:10px}
.cb-li{display:flex;align-items:flex-start;gap:12px;font-size:16px;line-height:1.35;transition:opacity .3s}
.cb-li-off{opacity:.35;text-decoration:line-through}
.cb-li-hero{font-weight:800}
.cb-li-hero .cb-li-text{background:linear-gradient(transparent 8%,#E9A93C 8%,#E9A93C 92%,transparent 92%);padding:0 4px;box-decoration-break:clone;-webkit-box-decoration-break:clone}
.cb-li-hero .cb-tick{background:#E9A93C;color:#171310}
.cb-tick{flex:none;width:22px;height:22px;border-radius:50%;background:#171310;color:#F4EADA;display:grid;place-items:center;margin-top:1px}
.cb-li-off .cb-tick{background:transparent;border:1.5px solid rgba(23,19,16,.5);color:transparent}
.cb-panel{border-radius:18px;padding:16px 18px;display:flex;flex-direction:column;gap:6px}
.cb-btn{display:flex;align-items:center;justify-content:center;min-height:58px;padding:0 24px;border-radius:999px;background:#171310;color:#F4EADA!important;text-decoration:none;font:700 17px var(--tk-f-sans)}
.cb-btn:hover{background:#B3202B;color:#fff!important}
.cb-left{margin:0;display:flex;flex-wrap:wrap;align-items:center;gap:6px 8px;font:600 13px var(--tk-f-mono)}
.cb-left-n{background:#B3202B;color:#F4EADA;padding:4px 9px;border-radius:999px;font-weight:700}
.cb-left-sep{opacity:.5}
.cb-fade{animation:cbFade .4s ease both}
@keyframes cbFade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
{%- endstyle -%}
{%- liquid
  assign p = section.settings.product
  if p == blank
    assign p = all_products['tekila-anxiety']
  endif
  assign ritual_price = 180000
  assign passport_price = 250000
  for v in p.variants
    assign t = v.title | downcase
    if t contains 'passport'
      assign passport_price = v.price
    elsif t contains 'ritual'
      assign ritual_price = v.price
    endif
  endfor
  assign taken_count = 0
  for n in p.metafields.tekila.taken_numbers.value
    if n >= 101 and n <= 200
      assign taken_count = taken_count | plus: 1
    endif
  endfor
  assign left = 100 | minus: taken_count
  assign base = p.url | default: '/products/tekila-anxiety'
  assign tick = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>'
-%}
<section id="reserve" aria-labelledby="cb-h-{{ section.id }}" style="background: #D8C3A0; color: #171310; padding: 64px 20px 72px">
  <tk-box class="tk-split" data-base="{{ base }}" style="max-width: 480px; margin: 0 auto; display: flex; flex-direction: column; gap: 22px">
    <div class="tk-split-head">
    <h2 id="cb-h-{{ section.id }}" style="margin: 0; display: flex; flex-direction: column; gap: 4px">
      <span class="cb-wide" style="font-size: 50px; line-height: .9">Pick your</span>
      <span class="cb-wide" style="font-size: 50px; line-height: .9">way in.</span>
      <span class="cb-serif" style="font-size: 28px; line-height: 1.1; color: #B3202B; margin-top: 6px">{{ section.settings.subline }}</span>
    </h2>
    </div>
    <div class="tk-split-body">

    <div class="cb-switch" role="radiogroup" aria-label="Choose Ritual or Passport">
      <span class="cb-knob" aria-hidden="true" data-knob></span>
      <button type="button" role="radio" aria-checked="true" class="cb-opt" data-plan="passport"><span class="cb-opt-name">Passport</span><span class="cb-opt-price">{% render 'tk-price', cents: passport_price %}</span></button>
      <button type="button" role="radio" aria-checked="false" class="cb-opt" data-plan="ritual" tabindex="-1"><span class="cb-opt-name">Ritual</span><span class="cb-opt-price">{% render 'tk-price', cents: ritual_price %}</span></button>
    </div>

    <div class="cb-scene" role="img" aria-label="The Passport box: bottle, letter, numbered passport, contract and gatherings invitation" data-scene>
      <div class="cb-back"></div>
      <div class="cb-flap cb-flap-shut" data-flap></div>
      <div class="cb-item cb-contract" data-item="contract"><span class="cb-mono" style="font-size: 8px; font-weight: 600; letter-spacing: .1em">CONTRATO</span><span class="cb-rule"></span><span class="cb-rule"></span><span class="cb-rule" style="width: 70%"></span><span class="cb-rule"></span><span class="cb-rule" style="width: 55%"></span></div>
      <div class="cb-item cb-card" data-item="card"><span class="cb-mono" style="font-size: 8px; font-weight: 600; letter-spacing: .1em">INVITACIÓN</span><span class="cb-wide" style="font-size: 12px; line-height: 1">Gatherings</span></div>
      <div class="cb-item cb-letter" data-item="letter"><span class="cb-wax">T</span></div>
      <div class="cb-item cb-pass" data-item="pass">
        <span class="cb-mono" style="font-size: 8px; font-weight: 600; letter-spacing: .12em; opacity: .7">TEKILA · PASAPORTE</span>
        <span class="cb-wide" style="font-size: 20px; line-height: 1; color: #E9A93C">Nº 1__</span>
        <span style="margin-top: auto; font-size: 8px; opacity: .6" class="cb-mono">NAME</span>
        <span style="font-size: 12px; font-weight: 700; line-height: 1.15">Your name</span>
      </div>
      <div class="cb-item cb-bottle" data-item="bottle">{%- render 'tk-bottle', w: 200 -%}</div>
      <button type="button" class="cb-front" data-front aria-label="Open the box"><span class="cb-front-mark">Tekila</span><span class="cb-front-sub" data-boxsub>THE PASSPORT</span></button>
    </div>

    <ul class="cb-list" aria-label="What's in the box">
      <li class="cb-li"><span class="cb-tick" aria-hidden="true">{{ tick }}</span><span class="cb-li-text">Tekila Anxiety, 50 ml</span></li>
      <li class="cb-li"><span class="cb-tick" aria-hidden="true">{{ tick }}</span><span class="cb-li-text">A stranger’s letter, sealed with the red T</span></li>
      <li class="cb-li" data-pass-only><span class="cb-tick" aria-hidden="true">{{ tick }}</span><span class="cb-li-text">Your numbered passport: you pick the number</span></li>
      <li class="cb-li" data-pass-only><span class="cb-tick" aria-hidden="true">{{ tick }}</span><span class="cb-li-text">Your membership contract</span></li>
      <li class="cb-li cb-li-hero" data-pass-only><span class="cb-tick" aria-hidden="true">{{ tick }}</span><span class="cb-li-text">Access to the TEKILA community and monthly gatherings</span></li>
    </ul>

    <div class="cb-panel cb-fade" data-rit-only hidden style="background: #F4EADA; border: 1.5px dashed rgba(23,19,16,.35)">
      <p class="cb-wide" style="margin: 0; font-size: 15px">Not sure yet?</p>
      <p style="margin: 0; font-size: 15px; line-height: 1.45">{{ section.settings.upgrade }}</p>
    </div>

    <div style="display: flex; flex-direction: column; gap: 12px; margin-top: 4px">
      <p class="cb-left" data-pass-show><span class="cb-left-n">{{ left }} of 100 passports left</span><span class="cb-left-sep">·</span><span>{{ section.settings.window_line }}</span></p>
      <div style="display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap">
        <span class="cb-wide" style="font-size: 40px; line-height: 1" data-price data-pass="{% render 'tk-price', cents: passport_price %}" data-rit="{% render 'tk-price', cents: ritual_price %}">{% render 'tk-price', cents: passport_price %}</span>
        <span class="cb-mono" style="font-size: 13px; opacity: .55; text-decoration: line-through" data-pass-show>{{ section.settings.future_price }}</span>
      </div>
      <a href="{{ base }}?edition=passport" class="cb-btn" data-cta>Reserve the Passport</a>
    </div>
    </div>
  </tk-box>
</section>
<script>
  if (!customElements.get('tk-box')) customElements.define('tk-box', class extends HTMLElement {
    connectedCallback() {
      var self = this, plan = 'passport', open = false;
      var q = function (s) { return self.querySelector(s); }, qa = function (s) { return self.querySelectorAll(s); };
      var poses = { bottle: [0, -76, -60, 0, .1, 1], letter: [-6, 18, -140, -100, .22, -12], pass: [4, 4, -110, -110, .32, 9], contract: [-10, -10, -130, -130, .4, -6], card: [6, 6, -170, -170, .48, 7] };
      var render = function () {
        var pass = plan === 'passport';
        q('[data-knob]').className = 'cb-knob' + (pass ? '' : ' cb-knob-r');
        qa('[data-plan]').forEach(function (b) { var on = b.dataset.plan === plan; b.setAttribute('aria-checked', on ? 'true' : 'false'); b.tabIndex = on ? 0 : -1; });
        q('[data-flap]').className = 'cb-flap ' + (open ? 'cb-flap-open' : 'cb-flap-shut');
        q('[data-front]').setAttribute('aria-label', open ? 'Close the box' : 'Open the box');
        q('[data-boxsub]').textContent = pass ? 'THE PASSPORT' : 'THE RITUAL';
        q('[data-scene]').setAttribute('aria-label', pass ? 'The Passport box: bottle, letter, numbered passport, contract and gatherings invitation' : 'The Ritual box: bottle and a stranger’s letter');
        qa('[data-item]').forEach(function (el) {
          var k = el.dataset.item, p = poses[k], show = k === 'bottle' || k === 'letter' || pass, vis = open && show;
          var x = k === 'bottle' ? 0 : (pass ? p[0] : p[1]), y = k === 'bottle' ? (pass ? -76 : -60) : (pass ? p[2] : p[3]), r = k === 'bottle' ? 0 : p[5];
          el.style.transform = vis ? 'translate(' + x + 'px,' + y + 'px) rotate(' + r + 'deg)' : 'translate(0,90px) rotate(0deg)';
          el.style.opacity = vis ? 1 : 0; el.style.transitionDelay = (vis ? p[4] : 0) + 's';
        });
        qa('[data-pass-only]').forEach(function (li) { li.classList.toggle('cb-li-off', !pass); });
        qa('[data-pass-show]').forEach(function (el) { el.hidden = !pass; });
        q('[data-rit-only]').hidden = pass;
        var price = q('[data-price]'); price.textContent = pass ? price.dataset.pass : price.dataset.rit;
        var cta = q('[data-cta]'); cta.textContent = pass ? 'Reserve the Passport' : 'Reserve the Ritual'; cta.href = self.dataset.base + '?edition=' + plan;
      };
      qa('[data-plan]').forEach(function (b, i, all) {
        b.addEventListener('click', function () { plan = b.dataset.plan; open = true; render(); });
        b.addEventListener('keydown', function (e) {
          if (['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown'].indexOf(e.key) < 0) return;
          e.preventDefault(); var o = all[(i + 1) % 2]; o.focus(); plan = o.dataset.plan; open = true; render();
        });
      });
      q('[data-front]').addEventListener('click', function () { open = !open; render(); });
      render();
      var scene = q('[data-scene]');
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (es) { if (es[0].isIntersecting) { io.disconnect(); setTimeout(function () { open = true; render(); }, 300); } }, { threshold: .4 });
        io.observe(scene);
      } else { open = true; render(); }
    }
  });
</script>

{% schema %}
{
  "name": "TEKILA ritual or passport",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "subline", "label": "Subline", "default": "Every bottle is made after you reserve it." },
    { "type": "inline_richtext", "id": "upgrade", "label": "Ritual note", "default": "Start with the Ritual. Upgrade to the Passport for <strong>700 EGP</strong> anytime before 31 Dec." },
    { "type": "text", "id": "window_line", "label": "Window line", "default": "Window 1 closes 31 Dec" },
    { "type": "text", "id": "future_price", "label": "Future price (struck through)", "default": "2,900 EGP from 1 January 2027" }
  ],
  "presets": [{ "name": "TEKILA ritual or passport" }]
}
{% endschema %}
