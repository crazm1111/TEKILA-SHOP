{%- comment -%}
  EasyKash "Pay now" sheet. Rendered once per page by both layouts.
  When Theme settings → EasyKash payments → Worker URL is set, it replaces Shopify checkout:
  every checkout button (cart drawer, cart page, Reserve on the product page) opens this sheet,
  and accelerated checkout buttons (Buy it now, Shop Pay…) are hidden.
  Empty URL = off: the store behaves exactly as before.
  Server: github.com/crazm1111/tekila-easykash
{%- endcomment -%}
{%- assign tkpay_url = settings.easykash_worker_url | strip | remove: ' ' -%}
{%- if tkpay_url != blank -%}
  {%- assign tkpay_last = tkpay_url | slice: -1 -%}
  {%- if tkpay_last == '/' -%}{%- assign tkpay_url = tkpay_url | remove_last: '/' -%}{%- endif -%}
  {{ 'tk-pay.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'tk-pay.js' | asset_url }}" defer></script>

  <dialog class="tkpay" data-tkpay data-base="{{ tkpay_url | escape }}" aria-labelledby="tkpay-title">
    <form class="tkpay__panel" data-tkpay-form novalidate>
      <div class="tkpay__head">
        <h2 class="tkpay__h" id="tkpay-title">Delivery details</h2>
        <button type="button" class="tkpay__x" data-tkpay-close aria-label="Close">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>

      <ul class="tkpay__items" data-tkpay-items aria-label="Your order"></ul>

      <div class="tkpay__fields">
        <label class="tkpay__field"><span>Full name</span><input name="name" autocomplete="name" required minlength="2" maxlength="80"></label>
        <label class="tkpay__field"><span>Mobile number</span><input name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="01xxxxxxxxx" required maxlength="16" pattern="[\s\d+\-٠-٩]{10,16}"></label>
        <label class="tkpay__field"><span>Email</span><input name="email" type="email" inputmode="email" autocomplete="email" required maxlength="120"><small>Your order confirmation goes here.</small></label>
        <label class="tkpay__field"><span>Governorate</span>
          <select name="province" required autocomplete="address-level1">
            <option value="">Choose…</option>
            <option value="C">Cairo</option><option value="GZ">Giza</option><option value="ALX">Alexandria</option>
            <option value="KB">Qalyubia</option><option value="SHR">Sharqia</option><option value="DK">Dakahlia</option>
            <option value="GH">Gharbia</option><option value="MNF">Monufia</option><option value="BH">Beheira</option>
            <option value="KFS">Kafr el-Sheikh</option><option value="DT">Damietta</option><option value="PTS">Port Said</option>
            <option value="IS">Ismailia</option><option value="SUZ">Suez</option><option value="FYM">Faiyum</option>
            <option value="BNS">Beni Suef</option><option value="MN">Minya</option><option value="AST">Asyut</option>
            <option value="SHG">Sohag</option><option value="KN">Qena</option><option value="LX">Luxor</option>
            <option value="ASN">Aswan</option><option value="BA">Red Sea</option><option value="WAD">New Valley</option>
            <option value="MT">Matrouh</option><option value="SIN">North Sinai</option><option value="JS">South Sinai</option>
          </select>
        </label>
        <label class="tkpay__field"><span>City / area</span><input name="city" autocomplete="address-level2" required minlength="2" maxlength="60"></label>
        <label class="tkpay__field"><span>Address</span><input name="address" autocomplete="street-address" placeholder="Street, building, floor, apartment" required minlength="5" maxlength="200"></label>
      </div>

      <div class="tkpay__code" data-tkpay-codebox>
        <label class="tkpay__field"><span>Promo code</span><input autocomplete="off" autocapitalize="characters" spellcheck="false" maxlength="40" data-tkpay-code></label>
        <button type="button" class="tkpay__apply" data-tkpay-apply>Apply</button>
      </div>
      <p class="tkpay__applied" data-tkpay-applied hidden>
        <span>Code <b data-tkpay-applied-code></b> applied</span>
        <button type="button" data-tkpay-remove aria-label="Remove promo code">Remove</button>
      </p>
      <p class="tkpay__codemsg" data-tkpay-codemsg role="status" aria-live="polite" hidden></p>

      <dl class="tkpay__sum">
        <dt>Subtotal</dt><dd data-tkpay-sub>…</dd>
        <dt data-tkpay-dlabel hidden>Discount</dt><dd data-tkpay-disc hidden></dd>
        <dt>Delivery</dt><dd>Free</dd>
        <dt class="tkpay__total">Total</dt><dd class="tkpay__total" data-tkpay-total>…</dd>
      </dl>

      <p class="tkpay__msg" data-tkpay-msg role="alert" hidden></p>
      <button type="submit" class="tkpay__go" data-tkpay-go>Continue to payment</button>
      <div class="tkpay__methods" aria-label="Payment methods">
        <span>Card</span><span>Mobile wallet</span><span>Apple Pay</span>
      </div>
      <p class="tkpay__note">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
        You’ll pay securely on EasyKash. Your order is confirmed as soon as the payment goes through.
      </p>
    </form>
  </dialog>

  <div class="tkpay-done" data-tkpay-done hidden role="status" aria-live="polite">
    <div><b>Payment received</b><span>Opening your order…</span></div>
  </div>
{%- endif -%}
